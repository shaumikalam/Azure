{
  "name": "TelConnect CDR Pipeline",
  "schedule": {
    "quartz_cron_expression": "0 0 2 * * ?",
    "timezone_id": "Europe/Amsterdam",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 0,
  "parameters": [
    { "name": "processing_date", "default": "``" }
  ],
  "tasks": [
    {
      "task_key": "process_cdrs",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/shaumika@ajenatpharma.com/Azure/TelConnect Call Data Pipeline/11-implement-lakeflow-jobs",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false,
      "timeout_seconds": 1800,
      "health": {
        "rules": [
          { "metric": "RUN_DURATION_SECONDS", "op": "GREATER_THAN", "value": 1200 }
        ]
      }
    },
    {
      "task_key": "summarize_gold",
      "depends_on": [ { "task_key": "process_cdrs" } ],
      "run_if": "ALL_SUCCESS",
      "sql_task": {
        "query": { "query_id": "41af9c89-dd8f-4d3e-b1fe-b5a18496ce2f" },
        "warehouse_id": "8c717a440d022dc0"
      },
      "timeout_seconds": 0
    }
  ],
  "email_notifications": {
    "on_failure": [ "shaumik.alam@gmail.com" ],
    "no_alert_for_skipped_runs": true
  },
  "notification_settings": {
    "no_alert_for_skipped_runs": true,
    "no_alert_for_canceled_runs": true
  },
  "queue": { "enabled": true },
  "performance_target": "PERFORMANCE_OPTIMIZED",
  "format": "MULTI_TASK"
}
